+
+/// ECC scalar checksum computation.
+///
+/// The gpg-agent shipped with GnuPG 2.4.x calculates the checksum
+/// over ECC scalars differently.  This is side-effect of the
+/// premature introduction of the simple-octet-string (SOS) encoding
+/// into the GnuPG code.
+///
+/// See GnuPG commit 2b118516240b4bddd34c68c23a99bea56682a509.
+enum EccScalarChecksumMode {
+    /// Sum over the MPI wire encoding in u16.
+    MPI,
+
+    /// Sum over the "opaque MPI encoding" and its bit length in u16.
+    ///
+    /// "Opaque MPI" is a gcrypt mode for MPIs that don't represent
+    /// integers, and mustn't be used in arithmetic functions.  Oddly
+    /// enough, if the left-most bit is set, gcrypt will prefix it
+    /// with a zero byte, presumably to prevent it from being
+    /// interpreted as a sign-bit.
+    SOS,
+}
+
+impl EccScalarChecksumMode {
+    fn for_version(v: &str) -> EccScalarChecksumMode {
+        if v.starts_with("2.0.")
+            || v.starts_with("2.1.")
+            || v.starts_with("2.2.")
+        {
+            EccScalarChecksumMode::MPI
+        } else {
+            EccScalarChecksumMode::SOS
+        }
     }
 }
 
