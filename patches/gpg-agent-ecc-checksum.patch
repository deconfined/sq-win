+    /// Returns the keys managed by the agent.
+    async fn get_agent_version(&mut self) -> Result<String> {
+        self.send("GETINFO version")?;
+
+        let mut version = Vec::new();
+        while let Some(response) = self.next().await {
+            let response = response?;
+            match response {
+                Response::Ok { .. } => break,
+                Response::Comment { .. } => (),
+                Response::Data { partial } =>
+                    version.extend_from_slice(&partial[..]),
+                Response::Error { message, .. } =>
+                    return self.operation_failed(&message).await,
+                response =>
+                    return protocol_error(&response),
+            }
+        }
+
+        self.next().await; // Dummy read to send END.
+        Ok(String::from_utf8(version).map_err(|e| e.utf8_error())?)
     }
 
